# Copy this file to .env and fill in your values. Never commit .env.

# LLM provider: groq, gemini or ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_API_KEY=
# Optional: override the default model for the provider
# LLM_MODEL=openai/gpt-oss-120b   (run "python -m app.llm" to list Groq models)

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_DIR=chroma_db
COLLECTION_NAME=security_advisories
